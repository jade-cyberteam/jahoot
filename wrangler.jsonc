{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jahoot",
  "main": "src/index.ts",
  // At most the date baked into the installed workerd (1.YYYYMMDD.N) or tests
  // fail with ERR_FUTURE_COMPATIBILITY_DATE.
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Custom domain — Cloudflare creates the DNS record in the jett.io zone on deploy.
  "routes": [{ "pattern": "quiz.jett.io", "custom_domain": true }],

  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    // Every request goes through the Worker: it gates /admin (Access JWT) and
    // /api (bearer token), owns the WebSocket upgrade, and maps clean URLs like
    // /host/<quizId> onto asset files. html_handling is off and the Worker asks
    // for literal asset paths, so there is no implicit rewriting to reason about
    // (and no /x.html -> /x redirect loop).
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },

  "kv_namespaces": [
    {
      "binding": "DATA",
      "id": "b577904b193d4c9d987ffbf787cd8be9"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "Game" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Game"] }],

  "vars": {
    // Cloudflare Access application in front of https://quiz.jett.io/admin.
    // ACCESS_AUD is the application's Audience tag; ACCESS_TEAM_DOMAIN is
    // https://<team>.cloudflareaccess.com. Both empty = admin UI is open, which
    // the Worker refuses to serve unless ALLOW_INSECURE_ADMIN is "1" (local dev).
    "ACCESS_AUD": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ALLOW_INSECURE_ADMIN": "0"
  },

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }

  // Secrets (set with `npx wrangler secret put <NAME>`):
  //   API_TOKEN — bearer token for the quiz API used by AI tools / the skill
}
